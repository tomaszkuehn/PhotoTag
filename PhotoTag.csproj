<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PhotoTag</RootNamespace>
    <AssemblyName>PhotoTag</AssemblyName>

    <!-- Wersja i autorstwo — pokazywane w „Pomoc → O programie…” -->
    <Version>1.0.0</Version>
    <Product>PhotoTag</Product>
    <Authors>Tomasz Kuehn</Authors>
    <Company>Tomasz Kuehn</Company>
    <Copyright>© 2026 Tomasz Kuehn</Copyright>
    <Description>Geotagowanie zdjęć i filmów: uzupełnianie współrzędnych GPS na mapie.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExifLibNet" Version="2.1.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\map.html" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="LICENSE" LogicalName="PhotoTag.LICENSE" />
  </ItemGroup>

</Project>
