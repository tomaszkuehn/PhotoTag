<Window x:Class="PhotoTag.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoTag — ułóż kolejność zdjęć"
        Width="1300" Height="850" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="10,6" Background="#F1F1F1" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Zamknij (Esc)" Padding="12,4"
                        Margin="8,0,0,0" IsCancel="True" Click="CloseButton_Click"/>
                <Button x:Name="UndoButton" DockPanel.Dock="Right" Content="Cofnij (Ctrl+Z)" Padding="12,4"
                        Click="UndoButton_Click"/>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#333"
                           Text="Przeciągnij zdjęcie w miejsce, w którym powinno być na osi czasu (od lewej do prawej, wierszami). Zdjęcie dostaje czas sąsiada ±1 s; zmiana działa od razu. Cofnąć można 4 ostatnie przesunięcia."/>
            </DockPanel>
        </Border>

        <ListBox x:Name="Tiles" Grid.Row="1" Padding="6" SelectionMode="Single" AllowDrop="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonDown="Tiles_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="Tiles_PreviewMouseMove"
                 DragOver="Tiles_DragOver"
                 DragLeave="Tiles_DragLeave"
                 Drop="Tiles_Drop">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Margin="4" Padding="3" CornerRadius="4" BorderThickness="3"
                                        BorderBrush="Transparent" Background="Transparent">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#EAF3FC"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#CCE4F7"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="216" Height="216" Background="#F4F4F4" ToolTip="{Binding Item.FileName}">
                        <Image Source="{Binding Image}" Stretch="Uniform"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
