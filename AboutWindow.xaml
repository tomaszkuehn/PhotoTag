<Window x:Class="PhotoTag.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O programie PhotoTag"
        Icon="/Assets/PhotoTag.ico"
        Width="620" Height="560" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="ProductText" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="DescriptionText" Foreground="#555" Margin="0,2,0,10" TextWrapping="Wrap"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,1,12,1"/>
                    </Style>
                </Grid.Resources>
                <TextBlock Grid.Row="0" Text="Wersja:" Foreground="#666"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionText" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="Autor:" Foreground="#666"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AuthorText"/>
                <TextBlock Grid.Row="2" Text="Prawa autorskie:" Foreground="#666"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CopyrightText"/>
                <TextBlock Grid.Row="3" Text="Licencja:" Foreground="#666"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="MIT (pełny tekst poniżej)"/>
            </Grid>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Licencja">
                <TextBox x:Name="LicenseBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="6"/>
            </TabItem>
            <TabItem Header="Komponenty zewnętrzne">
                <TextBox x:Name="ThirdPartyBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" FontSize="12" Padding="6"/>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Kopiuj informacje" Padding="12,4" Click="CopyBtn_Click"/>
            <Button Content="Zamknij" Padding="16,4" Margin="8,0,0,0" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
