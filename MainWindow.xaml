<Window x:Class="PhotoTag.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PhotoTag — geotagowanie zdjęć"
        Width="1500" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="8,4" Background="#F1F1F1" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">
                <WrapPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="6,3,0,3"/>
                        <Setter Property="Padding" Value="10,4"/>
                    </Style>
                </WrapPanel.Resources>
                <TextBlock Text="Folder:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="FolderBox" Width="360" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,3"/>
                <Button x:Name="PickFolderBtn" Content="Wybierz folder…" Click="PickFolderBtn_Click"/>
                <Button x:Name="RefreshBtn" Content="Odśwież" Click="RefreshBtn_Click"/>
                <Button Content="Ułóż kolejność…" Click="OrderBtn_Click"
                        ToolTip="Osobny widok dużych miniatur: przeciągnij zdjęcie ze złą datą we właściwe miejsce na osi czasu"/>
                <TextBlock x:Name="CountText" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,4"/>
                <TextBlock Text="Ślad GPS:" VerticalAlignment="Center"/>
                <Button Content="Wczytaj…" Click="LoadTrackBtn_Click"
                        ToolTip="GPX, KML lub JSON z historii lokalizacji Google (Records.json, Timeline.json, Semantic Location History)"/>
                <Button Content="Wyczyść" Click="ClearTrackBtn_Click"/>
                <TextBlock x:Name="TrackInfo" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#555"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,4"/>
                <TextBlock Text="Foldery ref.:" VerticalAlignment="Center"
                           ToolTip="Zdjęcia z GPS z tych folderów (np. z telefonu) służą tylko jako źródło podpowiedzi"/>
                <Button Content="+ Dodaj…" Click="AddRefFolderBtn_Click"/>
                <Button Content="Wyczyść" Click="ClearRefFoldersBtn_Click"/>
                <TextBlock x:Name="RefInfo" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#555"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,4"/>
                <TextBlock Text="Zegar aparatu:" VerticalAlignment="Center"/>
                <ComboBox x:Name="CameraCombo" Width="190" Margin="6,3,0,3" SelectionChanged="CameraCombo_SelectionChanged"/>
                <TextBox x:Name="OffsetBox" Width="90" Margin="6,3,0,3" VerticalContentAlignment="Center"
                         ToolTip="Przesunięcie dodawane do czasu EXIF, np. +01:00:00, -00:03:20, +1.00:00:00 (dni)"/>
                <Button Content="Ustaw" Click="SetOffsetBtn_Click"/>
                <Button Content="Kalibruj" Click="CalibrateBtn_Click"
                        ToolTip="Zaznacz 2 zdjęcia tej samej sceny z różnych aparatów (jedno z GPS) albo 1 zdjęcie i wskaż na mapie, gdzie było zrobione (wymaga śladu GPS)"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,4"/>
                <TextBlock Text="Nowa sesja po przerwie" VerticalAlignment="Center"/>
                <TextBox x:Name="SessionGapBox" Width="40" Margin="6,3,0,3" VerticalContentAlignment="Center"
                         LostFocus="SessionGapBox_LostFocus" KeyDown="SessionGapBox_KeyDown"/>
                <TextBlock Text="min" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </WrapPanel>
        </Border>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Wybierz folder ze zdjęciami" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="PhotoList" Grid.Column="0" Margin="6"
                     SelectionMode="Extended"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     MouseDoubleClick="PhotoList_MouseDoubleCick">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Ułóż kolejność zdjęć…" Click="OrderBtn_Click" FontWeight="SemiBold"/>
                        <MenuItem Header="Ustaw datę i godzinę…" Click="SetTimeMenu_Click"/>
                        <MenuItem Header="Przesuń wcześniej (Alt+↑)" Click="MoveEarlierMenu_Click"/>
                        <MenuItem Header="Przesuń później (Alt+↓)" Click="MoveLaterMenu_Click"/>
                        <Separator/>
                        <MenuItem Header="Cofnij ostatnią zmianę czasu" Click="UndoTimeMenu_Click"/>
                        <MenuItem Header="Przywróć datę z EXIF" Click="ResetTimeMenu_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <DockPanel Background="#E4E9F0" Margin="0,6,0,2">
                                    <Button DockPanel.Dock="Right" Content="zaznacz" Padding="6,1" Margin="4,2"
                                            FontSize="11" Click="SelectSessionBtn_Click"
                                            ToolTip="Zaznacz zdjęcia tej sesji (G)"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"
                                               Margin="6,3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <!-- Własny szablon: domyślny (Aero2) prawie ukrywa zaznaczenie, gdy fokus jest na mapie. -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                            BorderThickness="2" CornerRadius="5" Padding="2,0"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#EAF3FC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#CCE4F7"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{Binding StatusBrush}" BorderThickness="2"
                                CornerRadius="4" Padding="4" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="72" Height="72" Source="{Binding Thumb}" Stretch="Uniform"/>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="250">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                               FontSize="11" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="#666"
                                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Camera}" FontSize="10" Foreground="#888"
                                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Column="1" Margin="4,6,6,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <Border x:Name="PreviewBorder" Grid.Row="0" Background="#EBEBEB" CornerRadius="4"
                        BorderBrush="#CCC" BorderThickness="1"
                        Cursor="Hand" PreviewMouseDown="PreviewBorder_MouseDown"
                        ToolTip="Klik = powiększenie nad mapą">
                    <Image x:Name="PreviewImage" Margin="4" Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,4">
                    <WrapPanel Orientation="Horizontal">
                        <WrapPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Margin" Value="0,2,8,2"/>
                                <Setter Property="Padding" Value="10,5"/>
                            </Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Margin" Value="4,2,8,2"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </WrapPanel.Resources>
                        <Button x:Name="ApplyButton" Content="Zapisz lokalizację → …_LOCPT (Enter)"
                                FontWeight="SemiBold" Click="ApplyButton_Click"
                                ToolTip="Zapisuje punkt mapy (i kierunek) w zaznaczonych zdjęciach"/>
                        <Button x:Name="InterpolateButton" Content="Uzupełnij automatycznie"
                                Click="InterpolateButton_Click"
                                ToolTip="Wszystkie zdjęcia bez GPS: ślad GPS, a gdy go brak — interpolacja między zdjęciami z GPS (Δ≤2 h)"/>
                        <Button x:Name="UndoButton" Content="Cofnij zapis (Ctrl+Z)" Click="UndoButton_Click" IsEnabled="False"/>
                        <CheckBox x:Name="ApplyAllCheck" Content="wszystkie bez GPS"/>
                        <CheckBox x:Name="DeleteOriginalCheck" Content="usuń oryginał po zapisie"/>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal">
                        <WrapPanel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Margin" Value="6,2,0,2"/>
                                <Setter Property="Padding" Value="8,3"/>
                            </Style>
                        </WrapPanel.Resources>
                        <TextBlock Text="Miejsca:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="PlacesCombo" Width="260" Margin="6,2,0,2"
                                  DisplayMemberPath="Display" SelectionChanged="PlacesCombo_SelectionChanged"/>
                        <Button Content="★ Zapisz" Click="AddFavoriteBtn_Click" ToolTip="Dodaj punkt mapy do ulubionych"/>
                        <Button Content="Usuń" Click="RemovePlaceBtn_Click" ToolTip="Usuń wybrane miejsce z listy"/>
                        <Button Content="Kopiuj (Ctrl+C)" Click="CopyBtn_Click"/>
                        <Button Content="Wklej (Ctrl+V)" Click="PasteBtn_Click"
                                ToolTip="Współrzędne, link Google Maps/OSM lub adres ze schowka"/>
                        <TextBlock x:Name="AddressText" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="#555" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                    </WrapPanel>
                    <TextBlock Foreground="#888" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Mapa: klik = punkt, przeciągnij = korekta, prawy klik = kierunek zdjęcia. Skróty: Enter zapis · N / Shift+N następne/poprzednie bez GPS · G zaznacz sesję · S Street View · Ctrl+C/V kopiuj/wklej punkt · Ctrl+Z cofnij · Zła data: „Ułóż kolejność…” lub Alt+↑/↓"/>
                </StackPanel>

                <Border Grid.Row="2" CornerRadius="4" BorderBrush="#CCC" BorderThickness="1">
                    <wv2:WebView2 x:Name="MapView"/>
                </Border>

                <Border x:Name="StreetViewBorder" Grid.Row="2" CornerRadius="4"
                        BorderBrush="#CCC" BorderThickness="1" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Background="#F1F1F1" LastChildFill="False">
                            <Button x:Name="StreetViewBack" Content="← Mapa" Click="StreetViewBack_Click"
                                    Padding="8,4" Margin="6"/>
                            <TextBlock Text="Street View (Google)" VerticalAlignment="Center"
                                       Margin="6,0,0,0" Foreground="#555"/>
                        </DockPanel>
                        <wv2:WebView2 x:Name="StreetView" Grid.Row="1"/>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="EnlargedOverlay" Grid.Column="1" Background="#111111"
                    Visibility="Collapsed" MouseDown="EnlargedOverlay_MouseDown">
                <Grid>
                    <Image x:Name="EnlargedImage" Stretch="Uniform" Margin="10"/>
                    <TextBlock Text="Kliknij lub Esc — zamknij podgląd" Foreground="#AAA"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,16,10" FontSize="12"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
